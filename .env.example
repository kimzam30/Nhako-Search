# Copy to .env.local and fill in. Both values are safe to expose to the browser:
# NEXT_PUBLIC_* is inlined into the client bundle by design, and the anon key
# is only as powerful as the row-level security policies allow.
#
# Find them in the Supabase dashboard under Project Settings → API.
#
# Without these the app still builds and runs, but auth, progress saving and
# multiplayer are dead: lib/multiplayer/supabase.ts falls back to a placeholder
# URL so createClient() cannot throw during prerendering, and logs a clear
# error instead of an opaque stack trace from inside a Turbopack chunk.
#
# The race and gameplay Playwright suites need real values to mean anything:
# with placeholders the realtime channels never connect and every assertion in
# them times out.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, development only: extra hosts (LAN IP, Tailscale IP, hostname) that
# may reach `next dev`. Comma-separated. See allowedDevOrigins in next.config.ts.
# DEV_ORIGINS=192.168.1.20,my-box.local
